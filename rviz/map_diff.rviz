Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/Axes
      Name: Origin
      Enabled: true
      Length: 1
      Radius: 0.1
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/PointCloud2
      Name: Only in Map A (Orange)
      Enabled: true
      Topic:
        Value: /map_diff/only_a
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 3
      Size (m): 0.15
      Style: Spheres
      Color Transformer: RGB8
      Use Fixed Frame: true
      Use rainbow: false

    - Class: rviz_default_plugins/PointCloud2
      Name: Only in Map B (Cyan)
      Enabled: true
      Topic:
        Value: /map_diff/only_b
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 3
      Size (m): 0.15
      Style: Spheres
      Color Transformer: RGB8
      Use Fixed Frame: true
      Use rainbow: false

    - Class: rviz_default_plugins/PointCloud2
      Name: Common (Green)
      Enabled: true
      Topic:
        Value: /map_diff/common
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Size (m): 0.1
      Style: Spheres
      Color Transformer: RGB8
      Alpha: 0.5
      Use Fixed Frame: true
      Use rainbow: false

    - Class: rviz_default_plugins/PointCloud2
      Name: Map A (Red)
      Enabled: false
      Topic:
        Value: /map_diff/map_a
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Size (m): 0.08
      Style: Points
      Color Transformer: RGB8
      Use Fixed Frame: true
      Use rainbow: false

    - Class: rviz_default_plugins/PointCloud2
      Name: Map B (Blue)
      Enabled: false
      Topic:
        Value: /map_diff/map_b
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Size (m): 0.08
      Style: Points
      Color Transformer: RGB8
      Use Fixed Frame: true
      Use rainbow: false

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point:
        X: -7
        Y: 0
        Z: -3
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Yaw: 0.8
